# Default local runtime. The current MVP only supports `ollama`.
LEXICHESS_PROVIDER=ollama
LEXICHESS_ENV_PROFILE=dev
LEXICHESS_DEFAULT_GAME_MODE=benchmark
LEXICHESS_DEFAULT_SEAT_CONTROLLER=model
LEXICHESS_DEFAULT_PERSONA_ROLE=referee

# Local SQLite path for game and turn logs.
LEXICHESS_DB_PATH=lexichess.db

# Safety limits for a single game.
LEXICHESS_MAX_PLIES=200
LEXICHESS_TEMPERATURE=0.2
LEXICHESS_MAX_OUTPUT_TOKENS=64

# Keep the raw provider payload for debugging and replay inspection.
LEXICHESS_LOG_RAW_RESPONSE_JSON=true
LEXICHESS_LOG_LEVEL=INFO
LEXICHESS_LOG_FORMAT_JSON=false
LEXICHESS_REDACT_SECRETS=true

# Comma-separated feature flags for unfinished or gated code paths.
LEXICHESS_FEATURE_FLAGS=settings-export

# Mode defaults. These are groundwork for later website and character flows.
LEXICHESS_BENCHMARK_ALLOW_BANTER=false
LEXICHESS_BENCHMARK_ALLOW_HUMAN_HANDOFFS=false
LEXICHESS_SHOWMATCH_ALLOW_BANTER=true
LEXICHESS_SHOWMATCH_REQUIRE_REFEREE=true
LEXICHESS_INTERACTIVE_ALLOW_HUMAN_TAKEOVER=true
LEXICHESS_INTERACTIVE_ALLOW_LLM_TAKEOVER=true
LEXICHESS_CHARACTER_ENABLE_VOICES=false
LEXICHESS_CHARACTER_ENABLE_AVATARS=false
LEXICHESS_CHARACTER_ENABLE_MEMORY=false

# Local Ollama server configuration.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_RETRY_ATTEMPTS=2
OLLAMA_RETRY_BASE_DELAY_SECONDS=0.25

# Optional auth if you front Ollama with a local gateway.
# OLLAMA_API_KEY=

# Local Stockfish configuration for benchmark anchors and engine analysis.
STOCKFISH_PATH=stockfish
STOCKFISH_DEPTH=12
STOCKFISH_MULTIPV=3
# STOCKFISH_MOVETIME_MS=
